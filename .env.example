# ========================================================
# TechInsightsAI v2.0 - Environment Configuration
# ========================================================

# MongoDB Database Connection
# Used by both Next.js App Router (apps/web) and AI Worker (apps/ai-worker)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/techinsights?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=30d

# Gemini AI API Key (Used by apps/ai-worker)
GEMINI_API_KEY=your_gemini_api_key_here

# App Base URL (for SEO OpenGraph and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
